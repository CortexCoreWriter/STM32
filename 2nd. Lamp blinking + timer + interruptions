#include "stm32f4xx.h"  // Заголовочный файл для STM32F4xx

volatile uint8_t led_state = 0; // Флаг состояния светодиода

// Инициализация GPIO для светодиода
void GPIO_Init_LED(void) {
    // Включение тактирования порта C
    RCC->AHB1ENR |= RCC_AHB1ENR_GPIOCEN;

    // Настройка PC13 как выход
    GPIOC->MODER &= ~(0x3 << (13 * 2)); // Очистка режима
    GPIOC->MODER |= (0x1 << (13 * 2));  // Режим "выход"

    // Опционально: настройка скорости и выхода
    GPIOC->OSPEEDR |= (0x3 << (13 * 2)); // Высокая скорость
    GPIOC->OTYPER &= ~(0x1 << 13);       // Выход push-pull
    GPIOC->PUPDR &= ~(0x3 << (13 * 2));  // Без подтяжки
}

// Инициализация таймера 2 для генерации прерываний
void TIM2_Init(void) {
    // Включение тактирования таймера
    RCC->APB1ENR |= RCC_APB1ENR_TIM2EN;

    // Настройка таймера для интервала 1 секунда
    TIM2->PSC = 16000 - 1; // Предделитель (если частота 16 МГц, то 16 000 делит на 16000)
    TIM2->ARR = 1000 - 1;  // Значение автозагрузки (1 секунда)

    // Разрешение прерывания по обновлению
    TIM2->DIER |= TIM_DIER_UIE;

    // Включение таймера
    TIM2->CR1 |= TIM_CR1_CEN;

    // Настройка NVIC для обработки прерываний таймера
    NVIC_SetPriority(TIM2_IRQn, 1);
    NVIC_EnableIRQ(TIM2_IRQn);
}

// Обработчик прерывания таймера 2
void TIM2_IRQHandler(void) {
    if (TIM2->SR & TIM_SR_UIF) { // Проверка флага обновления
        TIM2->SR &= ~TIM_SR_UIF; // Очистка флага

        // Инвертация состояния светодиода
        led_state = !led_state;

        if (led_state) {
            // Включить светодиод (PC13 в состояние HIGH)
            GPIOC->BSRR = GPIO_BSRR_BS13;
        } else {
            // Выключить светодиод (PC13 в состояние LOW)
            GPIOC->BSRR = GPIO_BSRR_BR13;
        }
    }
}

int main(void) {
    // Инициализация GPIO
    GPIO_Init_LED();

    // Инициализация таймера
    TIM2_Init();

    while (1) {
        // Основной цикл может быть пустым, все управляется прерываниями
    }
}
