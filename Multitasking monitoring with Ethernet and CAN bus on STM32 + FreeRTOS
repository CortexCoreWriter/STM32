// Реализация задач (пример)

void vEthernetTask(void *pvParameters) {
    for (;;) {
        // Обработка Ethernet, отправка данных на сервер
        // lwIP API для TCP/UDP
        vTaskDelay(pdMS_TO_TICKS(1000));
    }
}

void vCANTask(void *pvParameters) {
    for (;;) {
        // Обработка сообщений CAN
        // Отправка и прием
        vTaskDelay(pdMS_TO_TICKS(500));
    }
}

void vSensorTask(void *pvParameters) {
    for (;;) {
        // Считывание датчиков
        float temperature = Read_TemperatureSensor();
        float pressure = Read_PressureSensor();
        // Передача данных в очередь или глобальные переменные
        vTaskDelay(pdMS_TO_TICKS(2000));
    }
}

void vControlTask(void *pvParameters) {
    for (;;) {
        // Обработка команд, управление светодиодами
        vTaskDelay(pdMS_TO_TICKS(100));
    }
}
